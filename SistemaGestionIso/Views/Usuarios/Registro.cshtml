@model RegistroViewModel
@{
	ViewData["Title"] = "Registro";
}

 <div class="auth-wrapper">
        <div class="auth-card">
            <div class="auth-brand">
                <div class="brand-logo">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h1 class="brand-title">¡Comienza tu aventura! 🚀</h1>
                <p class="brand-subtitle">Crea tu cuenta y gestiona tus normas ISO</p>
            </div>

            <div class="auth-body">
                <form asp-action="Registro" asp-controller="Account" method="post">
                    @if (ViewData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>@ViewData["ErrorMessage"]</span>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PrimerNombre" class="form-label"></label>
                            <div class="input-group">
                                <i class="bi bi-person"></i>
                                <input asp-for="PrimerNombre" class="form-control" placeholder="Juan" />
                            </div>
                            <span asp-validation-for="PrimerNombre" class="invalid-feedback"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="SegundoNombre" class="form-label">Segundo Nombre</label>
                            <div class="input-group">
                                <i class="bi bi-person"></i>
                                <input asp-for="SegundoNombre" class="form-control" placeholder="Carlos (opcional)" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PrimerApellido" class="form-label"></label>
                            <div class="input-group">
                                <i class="bi bi-person-badge"></i>
                                <input asp-for="PrimerApellido" class="form-control" placeholder="Pérez" />
                            </div>
                            <span asp-validation-for="PrimerApellido" class="invalid-feedback"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="SegundoApellido" class="form-label"></label>
                            <div class="input-group">
                                <i class="bi bi-person-badge"></i>
                                <input asp-for="SegundoApellido" class="form-control" placeholder="García" />
                            </div>
                            <span asp-validation-for="SegundoApellido" class="invalid-feedback"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Celular" class="form-label">Celular</label>
                        <div class="input-group">
                            <i class="bi bi-phone"></i>
                            <input asp-for="Celular" class="form-control" placeholder="999 999 999 (opcional)" />
                        </div>
                    </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="auth-input-group">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="invalid-feedback"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="auth-input-group">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" id="password" autocomplete="new-password" />
                        <button type="button" class="password-toggle" onclick="togglePassword()">
                            <i class="bi bi-eye" id="toggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="invalid-feedback"></span>

                    <!-- Password Strength Indicator -->
                    <div class="password-strength" id="passwordStrength">
                        <div class="strength-bar">
                            <div class="strength-bar-fill" id="strengthBarFill"></div>
                        </div>
                        <span class="strength-text" id="strengthText"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3">
                    <i class="bi bi-check-circle"></i>
                    Crear Cuenta
                </button>

                <div class="divider">
                    <span>o regístrate con</span>
                </div>

                <div class="social-login">
                    <button type="button" class="btn-social" title="Google">
                        <i class="bi bi-google"></i>
                    </button>
                    <button type="button" class="btn-social" title="Facebook">
                        <i class="bi bi-facebook"></i>
                    </button>
                    <button type="button" class="btn-social" title="Microsoft">
                        <i class="bi bi-microsoft"></i>
                    </button>
                </div>

                    </form>
        </div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}