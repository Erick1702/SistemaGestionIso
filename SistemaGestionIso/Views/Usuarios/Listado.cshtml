@model UsuarioListadoViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
	ViewData["Title"] = "Listado de Usuarios";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Listado de Usuarios</h1>

@if (Model.Mensaje is not null)
{
	<div class="alert alert-success" role="alert">
		@Model.Mensaje
	</div>
}

<div>
	<a asp-action="Crear" class="btn btn-primary">
		<i class="bi bi-person-plus"></i>
		Nuevo Usuario
	</a>
</div>
@if (Model.Usuarios is not null)
{
	<table class="table table-hover">
		<thead>
			<tr>
				@* <th scope="col">ID</th> *@
				<th scope="col">Email</th>
				<th scope="col">Nombre Completo</th>
				<th scope="col">Acciones</th>
				
			</tr>

		</thead>
		<tbody>
			@foreach (var usuario in Model.Usuarios)
			{
				<tr>
					@* <td>@usuario.Id</td> *@
					<td>@usuario.Email</td>
					<td>@usuario.PrimerNombre</td>
					
					<td>
						<a asp-action="Editar" asp-route-id="@usuario.Id" class="btn btn-primary" data-voice="Editar @usuario.Email">Editar</a>
						<a asp-action="Eliminar" asp-route-id="@usuario.Id" class="btn btn-danger" data-voice="Eliminar @usuario.Email">Eliminar</a>
						<a asp-action="RolesUsuario" asp-route-usuarioId="@usuario.Id" class="btn btn-primary" data-voice="Editar roles">Editar Roles</a>
					</td>
				</tr>
			}
		</tbody>

	</table>
}
else
{
	<p>No hay usuarios para mostrar</p>
}