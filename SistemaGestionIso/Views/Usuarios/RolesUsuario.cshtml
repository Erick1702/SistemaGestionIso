@model UsuarioRolesUsuarioViewModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{

	ViewData["Title"] = "Roles del Usuario";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<h3>Roles del Usuario: @Model.Email</h3>

<p>Roles :</p>
<form asp-action="EditarRoles">
	<input type="hidden" asp-for="UsuarioId" />
	@foreach (var rol in Model.Roles)
	{
		<div class="form-check">
			<input class="form-check-input" type="checkbox" name="RolesSeleccionados"
			value="@rol.Nombre" id="@rol.Nombre" @(rol.TieneRol ? "checked" : "")/>

			<label class="form-check-label" for="@rol.Nombre">
				@rol.Nombre
		</div>
	}
	<button class="btn btn-primary mt-2">
		Guardar
	</button>

	<a class="btn btn-link mt-2" asp-action="Listado">
		Cancelar
	</a>


</form>