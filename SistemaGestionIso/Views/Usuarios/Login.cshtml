@model LoginViewModel

@{
		ViewData["Title"] = "Iniciar Sesión";
}

    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="auth-brand">
                <div class="brand-logo">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h1 class="brand-title">Bienvenido a ISO Manager! 👋</h1>
                <p class="brand-subtitle">Inicia sesión en tu cuenta para comenzar</p>
            </div>

            <div class="auth-body">
                <form asp-action="Login" asp-controller="Usuarios" method="post">
                    @if (ViewData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>@ViewData["ErrorMessage"]</span>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <i class="bi bi-envelope"></i>
                            <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="invalid-feedback"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group">
                            <i class="bi bi-lock"></i>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" id="password" autocomplete="current-password" />
                            <button type="button" class="password-toggle" onclick="togglePassword()">
                                <i class="bi bi-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="invalid-feedback"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input asp-for="Recuerdame" class="form-check-input" type="checkbox" id="rememberMe" />
                            <label asp-for="Recuerdame" class="form-check-label" for="rememberMe">
                                Recuérdame
                            </label>
                        </div>
                        <div class="forgot-password">
                            <a asp-action="ForgotPassword" asp-controller="Usuarios">¿Olvidaste tu contraseña?</a>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">
                        Iniciar Sesión
                    </button>

                    <div class="divider">
                        <span>o continúa con</span>
                    </div>

                    <div class="social-login">
                        <button type="button" class="btn-social" title="Google">
                            <i class="bi bi-google"></i>
                        </button>
                        <button type="button" class="btn-social" title="Facebook">
                            <i class="bi bi-facebook"></i>
                        </button>
                        <button type="button" class="btn-social" title="Microsoft">
                            <i class="bi bi-microsoft"></i>
                        </button>
                    </div>
                </form>
            </div>

            <div class="auth-footer">
                <p>¿No tienes una cuenta? <a asp-action="Registro" asp-controller="Usuarios">Regístrate aquí</a></p>
            </div>
        </div>
    </div>


