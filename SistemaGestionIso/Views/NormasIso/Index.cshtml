
@model IEnumerable<NormaIsoViewModel>

@{
    ViewData["Title"] = "Normas ISO";
}

<h2>Normas ISO</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Norma</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Versión</th>
            <th>Descripción</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Version</td>
                <td>@item.Descripcion</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.NormaISOId">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.NormaISOId">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.NormaISOId">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
