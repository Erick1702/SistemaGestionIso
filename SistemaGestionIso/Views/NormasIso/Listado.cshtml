@model NormaIsoListadoViewModel

@{
	ViewData["Title"] = "Listado de Normas ISO";

}

<h1>Listado de Normas ISO</h1>

@if (Model.Mensaje is not null)
{
	<div class="alert alert-success" role="alert">
		@Model.Mensaje
	</div>
}

<a asp-action="Crear" class="btn btn-primary mb-3">
	Nuevo
</a>

@if (Model.NormasIso is not null)
{
	<table class="table table-striped table-hover">
		<thead class="table-dark">
			<tr>
				@* <th scope="col">ID</th> *@
				<th scope="col">Nombre</th>
				<th scope="col">Versión</th>
				<th scope="col">Descripción</th>
				<th scope="col">Acciones</th>

			</tr>
		</thead>
		<tbody>
			@foreach (var norma in Model.NormasIso)
			{
				<tr>
					@* <td>@norma.Id</td> *@
					<td>@norma.Nombre</td>
					<td>@norma.Version</td>
					<td>@norma.Descripcion</td>

					<td>
						<a asp-action="Editar" asp-route-id="@norma.NormaISOId" class="btn btn-primary" >Editar</a>
						<a asp-action="Eliminar" asp-route-id="@norma.NormaISOId" class="btn btn-danger">Eliminar</a>
						<a asp-controller="Clausulas"  asp-action="Listado"  asp-route-id="@norma.NormaISOId" class="btn btn-success">Gestionar Clausulas</a>

					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<p>No hay normas ISO para mostrar</p>
}
