@using SistemaGestionIso.Models.NormasIso
@model NormaIsoCrearViewModel
@{
    ViewData["Title"] = "Registrar Norma ISO";
}

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-gradient">Registrar Norma ISO</h2>
                    <p class="text-muted">Agrega una nueva norma ISO al sistema</p>
                </div>

                <form asp-action="Crear">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-4">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Ej. ISO 9001" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Version" class="form-label fw-semibold"></label>
                        <input asp-for="Version" class="form-control form-control-lg" placeholder="Ej. 2015" />
                        <span asp-validation-for="Version" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                        <textarea asp-for="Descripcion" class="form-control form-control-lg" placeholder="Breve descripción..." rows="4"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">💾 Guardar Norma</button>
                        <a asp-action="Listado" class="btn btn-light border btn-lg">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    /* Gradiente moderno para el título */
    .text-gradient {
        background: linear-gradient(90deg, #007bff, #00c6ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>
