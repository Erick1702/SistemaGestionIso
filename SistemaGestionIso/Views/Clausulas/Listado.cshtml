@model ClausulaListadoViewModel

@{
    ViewData["Title"] = "Gestión de Cláusulas";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="mb-1" style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary);">
                    Gestión de Cláusulas
                </h4>
                <p class="mb-0" style="color: var(--text-muted); font-size: 0.875rem;">
                    Norma: <strong>@ViewBag.NombreNormaIso</strong> - Versión: <strong>@ViewBag.VersionNormaIso</strong>
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="NormasIso" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Volver a Normas ISO
                </a>
                <a asp-action="Crear" asp-route-normaIsoId="@ViewBag.NormaIsoId" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>
                    Nueva Cláusula
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Alert Messages -->
@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i>
        <span>@Model.Mensaje</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Total Cláusulas</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.Clausulas.Count()
                        </h3>
                    </div>
                    <div class="stats-icon primary">
                        <i class="bi bi-list-check"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Primera Cláusula</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @(Model.Clausulas.Any() ? Model.Clausulas.OrderBy(c => c.Orden).First().Codigo : "-")
                        </h3>
                    </div>
                    <div class="stats-icon success">
                        <i class="bi bi-arrow-down-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Última Cláusula</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @(Model.Clausulas.Any() ? Model.Clausulas.OrderBy(c => c.Orden).Last().Codigo : "-")
                        </h3>
                    </div>
                    <div class="stats-icon warning">
                        <i class="bi bi-arrow-up-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Norma ISO</p>
                        <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: var(--text-primary);">
                            @ViewBag.VersionNormaIso
                        </h3>
                    </div>
                    <div class="stats-icon info">
                        <i class="bi bi-journal-text"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
@if (Model.Clausulas.Any())
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Listado de Cláusulas</h5>
            <div class="d-flex gap-2">
                <div style="position: relative;">
                    <i class="bi bi-search" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);"></i>
                    <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Buscar..."
                           style="padding-left: 2.25rem; width: 200px; height: 36px;">
                </div>
            </div>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="table" id="clausulasTable">
                    <thead>
                        <tr>
                            <th style="width: 80px;">ORDEN</th>
                            <th style="width: 150px;">CÓDIGO</th>
                            <th>DESCRIPCIÓN</th>
                            <th style="width: 200px; text-align: center;">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Clausulas.OrderBy(c => c.Orden))
                        {
                            <tr>
                                <td>
                                    <span class="badge badge-primary" style="font-size: 0.875rem; padding: 0.5rem 0.75rem;">
                                        #@item.Orden
                                    </span>
                                </td>
                                <td>
                                    <strong style="color: var(--text-primary);">@item.Codigo</strong>
                                </td>
                                <td style="color: var(--text-primary);">@item.Descripcion</td>
                                <td style="text-align: center;">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-controller="Requisitos"
                                           asp-action="Listado"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-info"
                                           title="Gestión de Requisitos"
                                           style="padding: 0.375rem 0.75rem;">
                                            <i class="bi bi-clipboard-check"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                title="Ver Detalles"
                                                style="padding: 0.375rem 0.75rem;"
                                                onclick="viewDetails(@item.Id, '@item.Codigo', '@item.Descripcion', @item.Orden)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <a asp-action="Editar" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-primary"
                                           title="Editar"
                                           style="padding: 0.375rem 0.75rem;">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                title="Eliminar"
                                                style="padding: 0.375rem 0.75rem;"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal-@item.Id">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Modal de Confirmación de Eliminación -->
                                    <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content" style="border-radius: 0.75rem; border: none;">
                                                <div class="modal-header" style="border-bottom: 1px solid var(--border-color); padding: 1.25rem 1.5rem;">
                                                    <h5 class="modal-title" style="color: var(--text-primary); font-weight: 600;">
                                                        <i class="bi bi-exclamation-triangle text-warning"></i>
                                                        Confirmar Eliminación
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body" style="padding: 1.5rem;">
                                                    <p style="margin: 0; color: var(--text-primary);">
                                                        ¿Está seguro de que desea eliminar la cláusula <strong>"@item.Codigo - @item.Descripcion"</strong>?
                                                    </p>
                                                    <p style="margin: 0.5rem 0 0 0; color: var(--text-muted); font-size: 0.875rem;">
                                                        Esta acción no se puede deshacer.
                                                    </p>
                                                </div>
                                                <div class="modal-footer" style="border-top: 1px solid var(--border-color); padding: 1rem 1.5rem;">
                                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                                        Cancelar
                                                    </button>
                                                    <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger">
                                                            <i class="bi bi-trash"></i>
                                                            Eliminar
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer" style="background-color: var(--body-bg); border-top: 1px solid var(--border-color); padding: 1rem 1.5rem;">
            <div class="d-flex justify-content-between align-items-center">
                <span style="color: var(--text-muted); font-size: 0.875rem;">
                    Mostrando <strong>@Model.Clausulas.Count()</strong> cláusulas
                </span>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center" style="padding: 3rem 1.5rem;">
            <div style="width: 80px; height: 80px; margin: 0 auto 1.5rem; background: rgba(115, 103, 240, 0.12); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-inbox" style="font-size: 2.5rem; color: var(--primary);"></i>
            </div>
            <h5 style="color: var(--text-primary); font-weight: 600; margin-bottom: 0.5rem;">
                No hay cláusulas registradas
            </h5>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem; max-width: 400px; margin-left: auto; margin-right: auto;">
                Comience agregando una nueva cláusula para la norma ISO <strong>@ViewBag.NombreNormaIso</strong>
            </p>
            <a asp-action="Crear" asp-route-normaIsoId="@ViewBag.NormaIsoId" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Crear Primera Cláusula
            </a>
        </div>
    </div>
}

<!-- Modal de Detalles -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 0.75rem; border: none;">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color); padding: 1.25rem 1.5rem; background: linear-gradient(135deg, rgba(115, 103, 240, 0.08) 0%, rgba(158, 149, 245, 0.08) 100%);">
                <h5 class="modal-title" style="color: var(--text-primary); font-weight: 600;">
                    <i class="bi bi-info-circle text-primary"></i>
                    Detalles de la Cláusula
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 1.5rem;">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Código</label>
                        <p id="detailCodigo" style="font-size: 1.125rem; font-weight: 600; color: var(--primary); margin: 0.25rem 0 0 0;"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Orden</label>
                        <p id="detailOrden" style="font-size: 1.125rem; font-weight: 600; color: var(--text-primary); margin: 0.25rem 0 0 0;"></p>
                    </div>
                    <div class="col-12 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Descripción</label>
                        <p id="detailDescripcion" style="font-size: 1rem; color: var(--text-primary); margin: 0.25rem 0 0 0; line-height: 1.6;"></p>
                    </div>
                    <div class="col-12">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Norma ISO</label>
                        <p style="font-size: 1rem; color: var(--text-primary); margin: 0.25rem 0 0 0;">
                            <strong>@ViewBag.NombreNormaIso</strong> - Versión @ViewBag.VersionNormaIso
                        </p>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--border-color); padding: 1rem 1.5rem;">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Búsqueda en tiempo real
        document.getElementById('searchInput')?.addEventListener('keyup', function() {
            const searchValue = this.value.toLowerCase();
            const tableRows = document.querySelectorAll('#clausulasTable tbody tr');

            tableRows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchValue) ? '' : 'none';
            });
        });

        // Función para mostrar detalles
        function viewDetails(id, codigo, descripcion, orden) {
            document.getElementById('detailCodigo').textContent = codigo;
            document.getElementById('detailDescripcion').textContent = descripcion;
            document.getElementById('detailOrden').textContent = '#' + orden;

            const modal = new bootstrap.Modal(document.getElementById('detailsModal'));
            modal.show();
        }

        // Auto-dismiss alerts
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}