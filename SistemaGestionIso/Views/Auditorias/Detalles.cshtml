@model SistemaGestionIso.Models.Auditoria.AuditoriaDetalleViewModel

@{
    ViewData["Title"] = "Detalles de Auditoría";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb" style="background: transparent; padding: 0; margin-bottom: 1rem;">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" style="color: var(--primary); text-decoration: none;">
                        <i class="bi bi-house-door"></i> Inicio
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-action="Index" style="color: var(--primary); text-decoration: none;">
                        Auditorías
                    </a>
                </li>
                <li class="breadcrumb-item active" style="color: var(--text-muted);">
                    Detalles
                </li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h4 class="mb-1" style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary);">
                    @Model.AreaAuditada
                </h4>
                <p class="mb-0" style="color: var(--text-muted); font-size: 0.875rem;">
                    Detalles completos de la auditoría
                </p>
            </div>
            <div class="d-flex gap-2">
                @if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG"))
                {
                    <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil"></i>
                        Editar
                    </a>
                }
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Alert Messages -->
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i>
        <span>@TempData["Mensaje"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <!-- Columna Principal -->
    <div class="col-lg-8">
        <!-- Información General -->
        <div class="card mb-4" style="background: linear-gradient(135deg, rgba(115, 103, 240, 0.08) 0%, rgba(158, 149, 245, 0.08) 100%); border: 1px solid rgba(115, 103, 240, 0.2);">
            <div class="card-body">
                <div class="d-flex align-items-start gap-3 mb-4">
                    <div style="width: 48px; height: 48px; background: var(--primary); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.25rem; flex-shrink: 0;">
                        <i class="bi bi-clipboard-data"></i>
                    </div>
                    <div style="flex: 1;">
                        <h5 style="margin: 0 0 0.5rem 0; color: var(--text-primary); font-weight: 600;">
                            Información General de la Auditoría
                        </h5>
                        <p style="margin: 0; color: var(--text-primary); opacity: 0.8;">
                            Visualiza todos los detalles y hallazgos registrados
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Área Auditada</label>
                        <p style="font-size: 1rem; color: var(--text-primary); margin: 0.25rem 0 0 0; font-weight: 600;">@Model.AreaAuditada</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Tipo de Auditoría</label>
                        <p style="margin: 0.25rem 0 0 0;">
                            <span class="badge badge-secondary" style="font-size: 0.875rem; padding: 0.5rem 1rem;">
                                @Model.TipoAuditoria
                            </span>
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Fecha de Inicio</label>
                        <div class="d-flex align-items-center gap-2" style="margin-top: 0.25rem;">
                            <i class="bi bi-calendar-event text-primary"></i>
                            <strong style="color: var(--text-primary);">@Model.FechaIni.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Fecha de Fin</label>
                        <div class="d-flex align-items-center gap-2" style="margin-top: 0.25rem;">
                            <i class="bi bi-calendar-check text-success"></i>
                            <strong style="color: var(--text-primary);">@Model.FechaFin.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Duración</label>
                        <div class="d-flex align-items-center gap-2" style="margin-top: 0.25rem;">
                            <i class="bi bi-clock text-info"></i>
                            <strong style="color: var(--text-primary);">@Model.DuracionDias días</strong>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Auditor Responsable</label>
                        @if (!string.IsNullOrEmpty(Model.NombreAuditor))
                        {
                            <div class="d-flex align-items-center gap-2" style="margin-top: 0.5rem;">
                                <div class="navbar-user-avatar" style="width: 40px; height: 40px; font-size: 1rem;">
                                    @Model.NombreAuditor.Substring(0, 1)
                                </div>
                                <div>
                                    <div style="font-weight: 600; color: var(--text-primary);">@Model.NombreAuditor</div>
                                    @if (!string.IsNullOrEmpty(Model.EmailAuditor))
                                    {
                                        <small style="color: var(--text-muted);">@Model.EmailAuditor</small>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <p style="margin: 0.5rem 0 0 0; color: var(--text-muted);">No asignado</p>
                        }
                    </div>
                    <div class="col-md-6">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Estado</label>
                        <p style="margin: 0.5rem 0 0 0;">
                            <span class="badge badge-@Model.ColorEstado" style="font-size: 1rem; padding: 0.5rem 1rem;">
                                <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i>
                                @Model.EstadoAuditoria
                            </span>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hallazgos -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0" style="color: var(--text-primary); font-weight: 600;">
                    <i class="bi bi-exclamation-triangle text-warning"></i>
                    Hallazgos (@Model.CantidadHallazgos)
                </h5>
                @if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG") || User.IsInRole("Auditor"))
                {
                    <a asp-controller="Hallazgos" asp-action="Crear" asp-route-auditoriaId="@Model.Id" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-circle"></i>
                        Nuevo Hallazgo
                    </a>
                }
            </div>
            <div class="card-body" style="padding: 0;">
                @if (!Model.Hallazgos.Any())
                {
                    <div class="text-center" style="padding: 3rem 1.5rem;">
                        <div style="width: 80px; height: 80px; margin: 0 auto 1.5rem; background: rgba(115, 103, 240, 0.12); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-clipboard-x" style="font-size: 2.5rem; color: var(--primary);"></i>
                        </div>
                        <h5 style="color: var(--text-primary); font-weight: 600; margin-bottom: 0.5rem;">
                            No hay hallazgos registrados
                        </h5>
                        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
                            No se han registrado hallazgos para esta auditoría
                        </p>
                        @if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG") || User.IsInRole("Auditor"))
                        {
                            <a asp-controller="Hallazgos" asp-action="Crear" asp-route-auditoriaId="@Model.Id" class="btn btn-sm btn-primary">
                                <i class="bi bi-plus-circle"></i>
                                Agregar Primer Hallazgo
                            </a>
                        }
                    </div>
                }
                else
                {
                    @foreach (var hallazgo in Model.Hallazgos)
                    {
                        <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color); border-left: 4px solid @GetTipoColor(hallazgo.Tipo);">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <div style="flex: 1;">
                                    <div class="d-flex align-items-center gap-2 flex-wrap" style="margin-bottom: 0.75rem;">
                                        <span class="badge badge-@GetTipoBadge(hallazgo.Tipo)" style="font-size: 0.8125rem; padding: 0.5rem 0.75rem;">
                                            @hallazgo.Tipo
                                        </span>
                                        @if (hallazgo.TieneEvidencia)
                                        {
                                            <span class="badge badge-info" title="Con evidencia" style="font-size: 0.75rem; padding: 0.375rem 0.625rem;">
                                                <i class="bi bi-paperclip"></i> Evidencia
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(hallazgo.CodigoClausula))
                                        {
                                            <span class="badge badge-secondary" style="font-size: 0.75rem; padding: 0.375rem 0.625rem;">
                                                @hallazgo.CodigoClausula
                                            </span>
                                        }
                                    </div>
                                    <p style="margin-bottom: 0.5rem; font-weight: 500; color: var(--text-primary); line-height: 1.6;">
                                        @hallazgo.Descripcion
                                    </p>
                                    @if (!string.IsNullOrEmpty(hallazgo.DescripcionRequisito))
                                    {
                                        <small style="color: var(--text-muted);">
                                            <i class="bi bi-info-circle"></i>
                                            Requisito: @hallazgo.DescripcionRequisito
                                        </small>
                                    }
                                </div>
                                <div class="d-flex gap-1 flex-shrink-0">
                                    <a asp-controller="Hallazgos" asp-action="Detalles" asp-route-id="@hallazgo.Id"
                                       class="btn btn-sm btn-info"
                                       title="Ver detalles"
                                       style="padding: 0.375rem 0.75rem;">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG"))
                                    {
                                        <a asp-controller="Hallazgos" asp-action="Editar" asp-route-id="@hallazgo.Id"
                                           class="btn btn-sm btn-primary"
                                           title="Editar"
                                           style="padding: 0.375rem 0.75rem;">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Columna Lateral -->
    <div class="col-lg-4">
        <!-- Estadísticas de Hallazgos -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0" style="color: var(--text-primary); font-weight: 600;">
                    <i class="bi bi-graph-up text-primary"></i>
                    Estadísticas de Hallazgos
                </h5>
            </div>
            <div class="card-body">
                <div style="margin-bottom: 1rem;">
                    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: 0.5rem;">
                        <span style="color: var(--text-secondary); font-size: 0.875rem;">
                            <i class="bi bi-list text-primary"></i> Total
                        </span>
                        <span class="badge badge-primary" style="font-size: 0.875rem; padding: 0.5rem 0.75rem;">@Model.CantidadHallazgos</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: var(--border-light);">
                        <div class="progress-bar" style="width: 100%; background-color: var(--primary);"></div>
                    </div>
                </div>

                <div style="margin-bottom: 1rem;">
                    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: 0.5rem;">
                        <span style="color: var(--text-secondary); font-size: 0.875rem;">
                            <i class="bi bi-x-circle text-danger"></i> No Conformidades
                        </span>
                        <span class="badge badge-danger" style="font-size: 0.875rem; padding: 0.5rem 0.75rem;">@Model.CantidadNoConformidades</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: var(--border-light);">
                        <div class="progress-bar" style="width: @(Model.CantidadHallazgos > 0 ? (Model.CantidadNoConformidades * 100.0 / Model.CantidadHallazgos) : 0)%; background-color: var(--danger);"></div>
                    </div>
                </div>

                <div style="margin-bottom: 1rem;">
                    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: 0.5rem;">
                        <span style="color: var(--text-secondary); font-size: 0.875rem;">
                            <i class="bi bi-exclamation-circle text-warning"></i> Observaciones
                        </span>
                        <span class="badge badge-warning" style="font-size: 0.875rem; padding: 0.5rem 0.75rem;">@Model.CantidadObservaciones</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: var(--border-light);">
                        <div class="progress-bar" style="width: @(Model.CantidadHallazgos > 0 ? (Model.CantidadObservaciones * 100.0 / Model.CantidadHallazgos) : 0)%; background-color: var(--warning);"></div>
                    </div>
                </div>

                <div>
                    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: 0.5rem;">
                        <span style="color: var(--text-secondary); font-size: 0.875rem;">
                            <i class="bi bi-check-circle text-success"></i> Conformidades
                        </span>
                        <span class="badge badge-success" style="font-size: 0.875rem; padding: 0.5rem 0.75rem;">@Model.CantidadConformidades</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: var(--border-light);">
                        <div class="progress-bar" style="width: @(Model.CantidadHallazgos > 0 ? (Model.CantidadConformidades * 100.0 / Model.CantidadHallazgos) : 0)%; background-color: var(--success);"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Progreso de la Auditoría -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0" style="color: var(--text-primary); font-weight: 600;">
                    <i class="bi bi-hourglass-split text-info"></i>
                    Progreso
                </h5>
            </div>
            <div class="card-body">
                @{
                    var totalDias = (Model.FechaFin - Model.FechaIni).Days + 1;
                    var diasTranscurridos = (DateTime.Now - Model.FechaIni).Days;
                    var progreso = Model.EstadoAuditoria == "Finalizada" ? 100 :
                    Model.EstadoAuditoria == "Programada" ? 0 :
                    (int)((diasTranscurridos * 100.0) / totalDias);
                    progreso = Math.Max(0, Math.Min(100, progreso));
                }

                <div class="text-center" style="margin-bottom: 1rem;">
                    <div style="font-size: 2rem; font-weight: 700; color: var(--primary);">@progreso%</div>
                    <small style="color: var(--text-muted);">Progreso de la auditoría</small>
                </div>

                <div class="progress" style="height: 10px; margin-bottom: 0.75rem; background-color: var(--border-light);">
                    <div class="progress-bar" style="width: @progreso%; background-color: var(--@Model.ColorEstado);"></div>
                </div>

                <div class="d-flex justify-content-between" style="color: var(--text-muted); font-size: 0.8125rem;">
                    <span>@Model.FechaIni.ToString("dd/MM")</span>
                    <span>@Model.FechaFin.ToString("dd/MM")</span>
                </div>
            </div>
        </div>

        <!-- Acciones Rápidas -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0" style="color: var(--text-primary); font-weight: 600;">
                    <i class="bi bi-lightning text-warning"></i>
                    Acciones Rápidas
                </h5>
            </div>
            <div class="card-body">
                @if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG") || User.IsInRole("Auditor"))
                {
                    <a asp-controller="Hallazgos" asp-action="Crear" asp-route-auditoriaId="@Model.Id"
                       class="btn btn-primary btn-sm w-100 mb-2">
                        <i class="bi bi-plus-circle"></i>
                        Agregar Hallazgo
                    </a>
                }
                @if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG"))
                {
                    <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm w-100 mb-2">
                        <i class="bi bi-pencil"></i>
                        Editar Auditoría
                    </a>
                }
                <button type="button" class="btn btn-info btn-sm w-100 mb-2" onclick="window.print()">
                    <i class="bi bi-printer"></i>
                    Imprimir Reporte
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-list"></i>
                    Ver Todas
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}

@functions {
    private string GetTipoColor(string tipo)
    {
        return tipo switch
        {
            "No Conformidad" => "var(--danger)",
            "Observación" => "var(--warning)",
            "Conformidad" => "var(--success)",
            _ => "var(--secondary)"
        };
    }

    private string GetTipoBadge(string tipo)
    {
        return tipo switch
        {
            "No Conformidad" => "danger",
            "Observación" => "warning",
            "Conformidad" => "success",
            _ => "secondary"
        };
    }
}