@model SistemaGestionIso.Models.Hallazgo.HallazgoListadoViewModel

@{
    ViewData["Title"] = "Hallazgos de Auditoría";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb" style="background: transparent; padding: 0; margin-bottom: 1rem;">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" style="color: var(--primary); text-decoration: none;">
                        <i class="bi bi-house-door"></i> Inicio
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Auditorias" asp-action="Index" style="color: var(--primary); text-decoration: none;">
                        Auditorías
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Auditorias" asp-action="Detalles" asp-route-id="@Model.AuditoriaId" style="color: var(--primary); text-decoration: none;">
                        Detalles
                    </a>
                </li>
                <li class="breadcrumb-item active" style="color: var(--text-muted);">
                    Hallazgos
                </li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="mb-1" style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary);">
                    Hallazgos de Auditoría
                </h4>
                <p class="mb-0" style="color: var(--text-muted); font-size: 0.875rem;">
                    Área: <strong>@ViewBag.AreaAuditada</strong> | Tipo: <strong>@ViewBag.TipoAuditoria</strong>
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Auditorias" asp-action="Detalles" asp-route-id="@ViewBag.AuditoriaId" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Volver a Auditoría
                </a>
                @if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG") || User.IsInRole("Auditor"))
                {
                    <a asp-action="Crear" asp-route-auditoriaId="@ViewBag.AuditoriaId" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i>
                        Nuevo Hallazgo
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Alert Messages -->
@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i>
        <span>@Model.Mensaje</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Auditoria Info Card -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card" style="background: linear-gradient(135deg, rgba(115, 103, 240, 0.08) 0%, rgba(158, 149, 245, 0.08) 100%); border: 1px solid rgba(115, 103, 240, 0.2);">
            <div class="card-body">
                <div class="d-flex align-items-start gap-3">
                    <div style="width: 48px; height: 48px; background: var(--primary); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.25rem; flex-shrink: 0;">
                        <i class="bi bi-clipboard-data"></i>
                    </div>
                    <div style="flex: 1;">
                        <h5 style="margin: 0 0 0.5rem 0; color: var(--text-primary); font-weight: 600;">
                            Auditoría: @ViewBag.AreaAuditada
                        </h5>
                        <p style="margin: 0; color: var(--text-primary); line-height: 1.6;">
                            <strong>Tipo:</strong> @ViewBag.TipoAuditoria | 
                            <strong>Periodo:</strong> @ViewBag.FechaInicioAuditoria.ToString("dd/MM/yyyy") - @ViewBag.FechaFinAuditoria.ToString("dd/MM/yyyy")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Total Hallazgos</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.Hallazgos.Count()
                        </h3>
                    </div>
                    <div class="stats-icon primary">
                        <i class="bi bi-list-ul"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Conformidades</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.TotalConformidades
                        </h3>
                    </div>
                    <div class="stats-icon success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">No Conformidades</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.TotalNoConformidades
                        </h3>
                    </div>
                    <div class="stats-icon danger">
                        <i class="bi bi-x-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Observaciones</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.TotalObservaciones
                        </h3>
                    </div>
                    <div class="stats-icon warning">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
@if (Model.Hallazgos.Any())
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Listado de Hallazgos</h5>
            <div style="position: relative;">
                <i class="bi bi-search" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);"></i>
                <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Buscar..."
                       style="padding-left: 2.25rem; width: 200px; height: 36px;">
            </div>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="table" id="hallazgosTable">
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>DESCRIPCIÓN</th>
                            <th style="width: 150px;">TIPO</th>
                            <th style="width: 180px;">REQUISITO</th>
                            <th style="width: 100px;">CLÁUSULA</th>
                            <th style="width: 80px; text-align: center;">EVID.</th>
                            <th style="width: 200px; text-align: center;">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int contador = 1;
                        }
                        @foreach (var item in Model.Hallazgos)
                        {
                            <tr>
                                <td>
                                    <span class="badge badge-secondary" style="font-size: 0.875rem; padding: 0.5rem 0.75rem;">
                                        @contador
                                    </span>
                                </td>
                                <td style="color: var(--text-primary);">
                                    @if (!string.IsNullOrEmpty(item.Descripcion))
                                    {
                                        <text>@item.Descripcion</text>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin descripción</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-@item.TipoColor" style="font-size: 0.875rem; padding: 0.5rem 0.75rem;">
                                        @item.Tipo
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.DescripcionRequisito))
                                    {
                                        <small style="color: var(--text-primary);">
                                            @(item.DescripcionRequisito.Length > 60 ? item.DescripcionRequisito.Substring(0, 60) + "..." : item.DescripcionRequisito)
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin requisito</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.CodigoClausula))
                                    {
                                        <span class="badge badge-info" style="font-size: 0.8125rem; padding: 0.5rem 0.75rem;">
                                            @item.CodigoClausula
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @if (item.TieneEvidencia)
                                    {
                                        <span class="badge badge-success" title="Con evidencia" style="font-size: 0.875rem; padding: 0.5rem 0.625rem;">
                                            <i class="bi bi-paperclip"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.875rem;">-</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-action="Detalles" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-info"
                                           title="Ver Detalles"
                                           style="padding: 0.375rem 0.75rem;">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG") || User.IsInRole("Auditor"))
                                        {
                                            <a asp-action="Editar" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-primary"
                                               title="Editar"
                                               style="padding: 0.375rem 0.75rem;">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                        @if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG"))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    title="Eliminar"
                                                    style="padding: 0.375rem 0.75rem;"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal-@item.Id">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                               
                            </tr>
                            contador++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer" style="background-color: var(--body-bg); border-top: 1px solid var(--border-color); padding: 1rem 1.5rem;">
            <div class="d-flex justify-content-between align-items-center">
                <span style="color: var(--text-muted); font-size: 0.875rem;">
                    Mostrando <strong>@Model.Hallazgos.Count()</strong> hallazgos
                </span>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center" style="padding: 3rem 1.5rem;">
            <div style="width: 80px; height: 80px; margin: 0 auto 1.5rem; background: rgba(115, 103, 240, 0.12); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-inbox" style="font-size: 2.5rem; color: var(--primary);"></i>
            </div>
            <h5 style="color: var(--text-primary); font-weight: 600; margin-bottom: 0.5rem;">
                No hay hallazgos registrados
            </h5>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem; max-width: 400px; margin-left: auto; margin-right: auto;">
                Comience agregando hallazgos a esta auditoría
            </p>
            @if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG") || User.IsInRole("Auditor"))
            {
                <a asp-action="Crear" asp-route-auditoriaId="@ViewBag.AuditoriaId" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>
                    Crear Primer Hallazgo
                </a>
            }
        </div>
    </div>
}

<!-- Modales de Eliminación (fuera de la tabla) -->
@if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG"))
{
    @foreach (var item in Model.Hallazgos)
    {
        <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius: 0.75rem; border: none;">
                    <div class="modal-header" style="border-bottom: 1px solid var(--border-color); padding: 1.25rem 1.5rem;">
                        <h5 class="modal-title" style="color: var(--text-primary); font-weight: 600;">
                            <i class="bi bi-exclamation-triangle text-warning"></i>
                            Confirmar Eliminación
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body" style="padding: 1.5rem;">
                        <p style="margin: 0; color: var(--text-primary);">
                            ¿Está seguro de que desea eliminar este hallazgo?
                        </p>
                        <p style="margin: 0.5rem 0 0 0; color: var(--text-muted); font-size: 0.875rem;">
                            Esta acción no se puede deshacer.
                        </p>
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid var(--border-color); padding: 1rem 1.5rem;">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i>
                                Eliminar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        // Búsqueda en tiempo real
        document.getElementById('searchInput')?.addEventListener('keyup', function() {
            const searchValue = this.value.toLowerCase();
            const tableRows = document.querySelectorAll('#hallazgosTable tbody tr');

            tableRows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchValue) ? '' : 'none';
            });
        });

        // Auto-dismiss alerts
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}