@model SistemaGestionIso.Models.Hallazgo.HallazgoListadoViewModel

@{
    ViewData["Title"] = "Todos los Hallazgos";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb" style="background: transparent; padding: 0; margin-bottom: 1rem;">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" style="color: var(--primary); text-decoration: none;">
                        <i class="bi bi-house-door"></i> Inicio
                    </a>
                </li>
                <li class="breadcrumb-item active" style="color: var(--text-muted);">
                    Hallazgos
                </li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="mb-1" style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary);">
                    <i class="bi bi-exclamation-triangle text-warning"></i>
                    Todos los Hallazgos
                </h4>
                <p class="mb-0" style="color: var(--text-muted); font-size: 0.875rem;">
                    Visualiza y gestiona todos los hallazgos de auditorías
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Auditorias" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-clipboard-check"></i>
                    Ver Auditorías
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Alert Messages -->
@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i>
        <span>@Model.Mensaje</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Total Hallazgos</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.Hallazgos.Count()
                        </h3>
                    </div>
                    <div class="stats-icon primary">
                        <i class="bi bi-list-ul"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Conformidades</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.TotalConformidades
                        </h3>
                    </div>
                    <div class="stats-icon success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">No Conformidades</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.TotalNoConformidades
                        </h3>
                    </div>
                    <div class="stats-icon danger">
                        <i class="bi bi-x-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Observaciones</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.TotalObservaciones
                        </h3>
                    </div>
                    <div class="stats-icon warning">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
@if (Model.Hallazgos.Any())
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="card-title mb-0">Listado de Todos los Hallazgos</h5>
            <div class="d-flex gap-2 flex-wrap">
                <div style="position: relative;">
                    <i class="bi bi-search" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);"></i>
                    <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Buscar..."
                           style="padding-left: 2.25rem; width: 200px; height: 36px;">
                </div>
                <select id="filterTipo" class="form-select form-select-sm" style="width: 180px; height: 36px;">
                    <option value="">Todos los tipos</option>
                    <option value="Conformidad">Conformidad</option>
                    <option value="No Conformidad">No Conformidad</option>
                    <option value="Observación">Observación</option>
                </select>
            </div>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="table" id="hallazgosTable">
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>DESCRIPCIÓN</th>
                            <th style="width: 120px;">TIPO</th>
                            <th style="width: 150px;">ÁREA AUDITADA</th>
                            <th style="width: 150px;">REQUISITO</th>
                            <th style="width: 100px;">CLÁUSULA</th>
                            <th style="width: 80px; text-align: center;">EVID.</th>
                            <th style="width: 180px; text-align: center;">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int contador = 1;
                        }
                        @foreach (var item in Model.Hallazgos)
                        {
                            <tr data-tipo="@item.Tipo">
                                <td>
                                    <span class="badge badge-secondary" style="font-size: 0.8125rem; padding: 0.375rem 0.625rem;">
                                        @contador
                                    </span>
                                </td>
                                <td style="color: var(--text-primary); max-width: 300px;">
                                    @if (!string.IsNullOrEmpty(item.Descripcion))
                                    {
                                        @(item.Descripcion.Length > 100 ? item.Descripcion.Substring(0, 100) + "..." : item.Descripcion)
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin descripción</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-@item.TipoColor" style="font-size: 0.8125rem; padding: 0.5rem 0.75rem;">
                                        @item.Tipo
                                    </span>
                                </td>
                                <td style="color: var(--text-primary);">
                                    @if (!string.IsNullOrEmpty(item.AreaAuditada))
                                    {
                                        @item.AreaAuditada
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.DescripcionRequisito))
                                    {
                                        <small style="color: var(--text-primary);">
                                            @(item.DescripcionRequisito.Length > 50 ? item.DescripcionRequisito.Substring(0, 50) + "..." : item.DescripcionRequisito)
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.CodigoClausula))
                                    {
                                        <span class="badge badge-info" style="font-size: 0.75rem; padding: 0.375rem 0.625rem;">
                                            @item.CodigoClausula
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @if (item.TieneEvidencia)
                                    {
                                        <span class="badge badge-success" title="Con evidencia" style="font-size: 0.75rem; padding: 0.375rem 0.5rem;">
                                            <i class="bi bi-paperclip"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.75rem;">-</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-action="Detalles" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-info"
                                           title="Ver detalles"
                                           style="padding: 0.375rem 0.75rem;">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-controller="Auditorias" asp-action="Detalles" asp-route-id="@item.AuditoriaId"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Ver auditoría"
                                           style="padding: 0.375rem 0.75rem;">
                                            <i class="bi bi-clipboard-check"></i>
                                        </a>
                                        @if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG") || User.IsInRole("Auditor"))
                                        {
                                            <a asp-action="Editar" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-primary"
                                               title="Editar"
                                               style="padding: 0.375rem 0.75rem;">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                            contador++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer" style="background-color: var(--body-bg); border-top: 1px solid var(--border-color); padding: 1rem 1.5rem;">
            <div class="d-flex justify-content-between align-items-center">
                <span style="color: var(--text-muted); font-size: 0.875rem;">
                    Mostrando <strong id="visibleCount">@Model.Hallazgos.Count()</strong> de <strong>@Model.Hallazgos.Count()</strong> hallazgos
                </span>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center" style="padding: 3rem 1.5rem;">
            <div style="width: 80px; height: 80px; margin: 0 auto 1.5rem; background: rgba(115, 103, 240, 0.12); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-inbox" style="font-size: 2.5rem; color: var(--primary);"></i>
            </div>
            <h5 style="color: var(--text-primary); font-weight: 600; margin-bottom: 0.5rem;">
                No hay hallazgos registrados
            </h5>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
                Comience registrando hallazgos en las auditorías
            </p>
            <a asp-controller="Auditorias" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-clipboard-check"></i>
                Ver Auditorías
            </a>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Búsqueda y filtrado
        const searchInput = document.getElementById('searchInput');
        const filterTipo = document.getElementById('filterTipo');
        const tableRows = document.querySelectorAll('#hallazgosTable tbody tr');
        const visibleCount = document.getElementById('visibleCount');

        function filterTable() {
            const searchValue = searchInput?.value.toLowerCase() || '';
            const tipoValue = filterTipo?.value || '';
            let visibleRows = 0;

            tableRows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const tipo = row.getAttribute('data-tipo');

                const matchSearch = text.includes(searchValue);
                const matchTipo = tipoValue === '' || tipo === tipoValue;

                if (matchSearch && matchTipo) {
                    row.style.display = '';
                    visibleRows++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (visibleCount) {
                visibleCount.textContent = visibleRows;
            }
        }

        searchInput?.addEventListener('keyup', filterTable);
        filterTipo?.addEventListener('change', filterTable);

        // Auto-dismiss alerts
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}