@model SistemaGestionIso.Models.Hallazgo.HallazgoDetalleViewModel

@{
    ViewData["Title"] = "Detalles del Hallazgo";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb" style="background: transparent; padding: 0; margin-bottom: 1rem;">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" style="color: var(--primary); text-decoration: none;">
                        <i class="bi bi-house-door"></i> Inicio
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Auditorias" asp-action="Index" style="color: var(--primary); text-decoration: none;">
                        Auditorías
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Auditorias" asp-action="Detalles" asp-route-id="@Model.AuditoriaId" style="color: var(--primary); text-decoration: none;">
                        Detalles
                    </a>
                </li>
                <li class="breadcrumb-item active" style="color: var(--text-muted);">
                    Hallazgo
                </li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h4 class="mb-1" style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary);">
                    Detalles del Hallazgo
                </h4>
                <p class="mb-0" style="color: var(--text-muted); font-size: 0.875rem;">
                    Información completa del hallazgo registrado
                </p>
            </div>
            <div class="d-flex gap-2">
                @if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG") || User.IsInRole("Auditor"))
                {
                    <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil"></i>
                        Editar
                    </a>
                }
                <a asp-action="Listado" asp-route-id="@Model.AuditoriaId" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Alert Messages -->
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i>
        <span>@TempData["Mensaje"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <!-- Columna Principal -->
    <div class="col-lg-8">
        <!-- Información del Hallazgo -->
        <div class="card mb-4" style="background: linear-gradient(135deg, rgba(115, 103, 240, 0.08) 0%, rgba(158, 149, 245, 0.08) 100%); border: 1px solid rgba(115, 103, 240, 0.2);">
            <div class="card-body">
                <div class="d-flex align-items-start gap-3 mb-4">
                    <div style="width: 48px; height: 48px; background: var(--primary); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.25rem; flex-shrink: 0;">
                        <i class="bi bi-exclamation-diamond"></i>
                    </div>
                    <div style="flex: 1;">
                        <h5 style="margin: 0 0 0.5rem 0; color: var(--text-primary); font-weight: 600;">
                            Información del Hallazgo
                        </h5>
                        <p style="margin: 0; color: var(--text-primary); opacity: 0.8;">
                            Detalle completo del hallazgo identificado en la auditoría
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Tipo de Hallazgo</label>
                        <p style="margin: 0.5rem 0 0 0;">
                            <span class="badge badge-@Model.TipoColor" style="font-size: 1rem; padding: 0.5rem 1rem;">
                                <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i>
                                @Model.Tipo
                            </span>
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">ID del Hallazgo</label>
                        <p style="font-size: 1rem; color: var(--text-primary); margin: 0.5rem 0 0 0; font-weight: 600;">#@Model.Id</p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Descripción</label>
                        <p style="font-size: 1rem; color: var(--text-primary); margin: 0.5rem 0 0 0; line-height: 1.6;">
                            @Model.Descripcion
                        </p>
                    </div>
                </div>

                <!-- Evidencia -->
                @if (!string.IsNullOrEmpty(Model.EvidenciaPath))
                {
                    <div class="row">
                        <div class="col-12">
                            <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Evidencia Adjunta</label>
                            <div style="margin-top: 0.5rem; padding: 1rem; background: white; border-radius: 0.5rem; border: 1px solid var(--border-color);">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-paperclip" style="font-size: 1.5rem; color: var(--success);"></i>
                                        <div>
                                            <div style="font-weight: 600; color: var(--text-primary);">@Model.NombreArchivoEvidencia</div>
                                            <small style="color: var(--text-muted);">Archivo adjunto</small>
                                        </div>
                                    </div>
                                    <a asp-action="DescargarEvidencia" asp-route-id="@Model.Id" class="btn btn-success btn-sm">
                                        <i class="bi bi-download"></i>
                                        Descargar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Información de la Auditoría -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0" style="color: var(--text-primary); font-weight: 600;">
                    <i class="bi bi-clipboard-data text-primary"></i>
                    Información de la Auditoría
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Área Auditada</label>
                        <p style="font-size: 1rem; color: var(--text-primary); margin: 0.25rem 0 0 0; font-weight: 600;">
                            @Model.AreaAuditada
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Tipo de Auditoría</label>
                        <p style="margin: 0.25rem 0 0 0;">
                            <span class="badge badge-secondary" style="font-size: 0.875rem; padding: 0.5rem 0.75rem;">
                                @Model.TipoAuditoria
                            </span>
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Fecha Inicio</label>
                        <div class="d-flex align-items-center gap-2" style="margin-top: 0.25rem;">
                            <i class="bi bi-calendar-event text-primary"></i>
                            <strong style="color: var(--text-primary);">@Model.FechaInicioAuditoria.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Fecha Fin</label>
                        <div class="d-flex align-items-center gap-2" style="margin-top: 0.25rem;">
                            <i class="bi bi-calendar-check text-success"></i>
                            <strong style="color: var(--text-primary);">@Model.FechaFinAuditoria.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.NombreAuditor))
                {
                    <hr style="margin: 1rem 0; border-color: var(--border-color);">
                    <div class="row">
                        <div class="col-12">
                            <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Auditor Responsable</label>
                            <div class="d-flex align-items-center gap-2" style="margin-top: 0.5rem;">
                                <div class="navbar-user-avatar" style="width: 40px; height: 40px; font-size: 1rem;">
                                    @Model.NombreAuditor.Substring(0, 1)
                                </div>
                                <div>
                                    <div style="font-weight: 600; color: var(--text-primary);">@Model.NombreAuditor</div>
                                    @if (!string.IsNullOrEmpty(Model.EmailAuditor))
                                    {
                                        <small style="color: var(--text-muted);">@Model.EmailAuditor</small>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Información del Requisito -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0" style="color: var(--text-primary); font-weight: 600;">
                    <i class="bi bi-list-check text-success"></i>
                    Requisito de la Norma ISO
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Norma ISO</label>
                        <p style="margin: 0.25rem 0 0 0;">
                            <span class="badge badge-info" style="font-size: 0.875rem; padding: 0.5rem 0.75rem;">
                                @Model.NombreNormaIso
                            </span>
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Cláusula</label>
                        <p style="margin: 0.25rem 0 0 0;">
                            <span class="badge badge-primary" style="font-size: 0.875rem; padding: 0.5rem 0.75rem;">
                                @Model.CodigoClausula
                            </span>
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Descripción de la Cláusula</label>
                        <p style="font-size: 0.9375rem; color: var(--text-primary); margin: 0.25rem 0 0 0; line-height: 1.6;">
                            @Model.DescripcionClausula
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Requisito Específico</label>
                        <p style="font-size: 0.9375rem; color: var(--text-primary); margin: 0.25rem 0 0 0; line-height: 1.6;">
                            @Model.DescripcionRequisito
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Columna Lateral -->
    <div class="col-lg-4">
        <!-- Acciones Rápidas -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0" style="color: var(--text-primary); font-weight: 600;">
                    <i class="bi bi-lightning text-warning"></i>
                    Acciones Rápidas
                </h5>
            </div>
            <div class="card-body">
                @if (User.IsInRole("Administrador") || User.IsInRole("Encargado SIG") || User.IsInRole("Auditor"))
                {
                    <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary btn-sm w-100 mb-2">
                        <i class="bi bi-pencil"></i>
                        Editar Hallazgo
                    </a>
                }
                <a asp-controller="Auditorias" asp-action="Detalles" asp-route-id="@Model.AuditoriaId" class="btn btn-info btn-sm w-100 mb-2">
                    <i class="bi bi-clipboard-check"></i>
                    Ver Auditoría Completa
                </a>
                @if (!string.IsNullOrEmpty(Model.EvidenciaPath))
                {
                    <a asp-action="DescargarEvidencia" asp-route-id="@Model.Id" class="btn btn-success btn-sm w-100 mb-2">
                        <i class="bi bi-download"></i>
                        Descargar Evidencia
                    </a>
                }
                <button type="button" class="btn btn-outline-secondary btn-sm w-100 mb-2" onclick="window.print()">
                    <i class="bi bi-printer"></i>
                    Imprimir Detalles
                </button>
                <a asp-action="Listado" asp-route-id="@Model.AuditoriaId" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-list"></i>
                    Ver Todos los Hallazgos
                </a>
            </div>
        </div>

        <!-- Información Resumida -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0" style="color: var(--text-primary); font-weight: 600;">
                    <i class="bi bi-info-circle text-info"></i>
                    Resumen
                </h5>
            </div>
            <div class="card-body">
                <div style="margin-bottom: 1rem;">
                    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: 0.5rem;">
                        <span style="color: var(--text-secondary); font-size: 0.875rem;">Tipo</span>
                        <span class="badge badge-@Model.TipoColor">@Model.Tipo</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: 0.5rem;">
                        <span style="color: var(--text-secondary); font-size: 0.875rem;">Auditoría</span>
                        <strong style="color: var(--text-primary); font-size: 0.875rem;">#@Model.AuditoriaId</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: 0.5rem;">
                        <span style="color: var(--text-secondary); font-size: 0.875rem;">Requisito</span>
                        <strong style="color: var(--text-primary); font-size: 0.875rem;">#@Model.RequisitoId</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span style="color: var(--text-secondary); font-size: 0.875rem;">Evidencia</span>
                        @if (!string.IsNullOrEmpty(Model.EvidenciaPath))
                        {
                            <span class="badge badge-success" style="font-size: 0.75rem;">
                                <i class="bi bi-check-circle"></i> Sí
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-secondary" style="font-size: 0.75rem;">
                                <i class="bi bi-x-circle"></i> No
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Información Contextual -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0" style="color: var(--text-primary); font-weight: 600;">
                    <i class="bi bi-bookmark text-primary"></i>
                    Contexto
                </h5>
            </div>
            <div class="card-body">
                <p style="margin: 0 0 1rem 0; font-size: 0.875rem; color: var(--text-secondary); line-height: 1.6;">
                    Este hallazgo fue identificado durante la auditoría <strong>@Model.TipoAuditoria</strong> del área <strong>@Model.AreaAuditada</strong>.
                </p>
                <p style="margin: 0; font-size: 0.875rem; color: var(--text-secondary); line-height: 1.6;">
                    Se relaciona con el requisito <strong>@Model.CodigoClausula</strong> de la norma <strong>@Model.NombreNormaIso</strong>.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}