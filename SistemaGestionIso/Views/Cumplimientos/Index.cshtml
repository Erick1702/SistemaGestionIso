@using SistemaGestionIso.Models.Cumplimiento
@model CumplimientoListadoViewModel

@{
    ViewData["Title"] = "Todos los Cumplimientos";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="mb-1" style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary);">
                    <i class="bi bi-check-circle text-primary"></i>
                    Todos los Cumplimientos
                </h4>
                <p class="mb-0" style="color: var(--text-muted); font-size: 0.875rem;">
                    Visualiza y gestiona todos los registros de cumplimiento
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Requisitos" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-clipboard-check"></i>
                    Ver Requisitos
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Alert Messages -->
@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i>
        <span>@Model.Mensaje</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Total Evaluaciones</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.Cumplimientos.Count()
                        </h3>
                    </div>
                    <div class="stats-icon primary">
                        <i class="bi bi-clipboard-data"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Cumple</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--success);">
                            @Model.TotalCumple
                        </h3>
                    </div>
                    <div class="stats-icon success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Parcial</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--warning);">
                            @Model.TotalParcial
                        </h3>
                    </div>
                    <div class="stats-icon warning">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">No Cumple</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--danger);">
                            @Model.TotalNoCumple
                        </h3>
                    </div>
                    <div class="stats-icon danger">
                        <i class="bi bi-x-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Porcentaje de Cumplimiento -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card" style="background: linear-gradient(135deg, rgba(115, 103, 240, 0.08) 0%, rgba(158, 149, 245, 0.08) 100%); border: 1px solid rgba(115, 103, 240, 0.2);">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width: 60px; height: 60px; background: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.5rem;">
                            <i class="bi bi-pie-chart"></i>
                        </div>
                        <div>
                            <h5 style="margin: 0 0 0.25rem 0; color: var(--text-primary); font-weight: 600;">
                                Porcentaje de Cumplimiento General
                            </h5>
                            <p style="margin: 0; color: var(--text-muted); font-size: 0.875rem;">
                                Basado en todas las evaluaciones realizadas
                            </p>
                        </div>
                    </div>
                    <div class="text-center">
                        <h2 style="margin: 0; font-size: 2.5rem; font-weight: 700; color: var(--primary);">
                            @Model.PorcentajeCumplimiento%
                        </h2>
                        <p style="margin: 0; color: var(--text-muted); font-size: 0.875rem;">de cumplimiento</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
@if (Model.Cumplimientos.Any())
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="card-title mb-0">Listado de Todos los Cumplimientos</h5>
            <div class="d-flex gap-2 flex-wrap">
                <div style="position: relative;">
                    <i class="bi bi-search" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);"></i>
                    <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Buscar..."
                           style="padding-left: 2.25rem; width: 200px; height: 36px;">
                </div>
                <select id="filterEstado" class="form-select form-select-sm" style="width: 180px; height: 36px;">
                    <option value="">Todos los estados</option>
                    <option value="Cumple">Cumple</option>
                    <option value="Parcial">Cumple Parcialmente</option>
                    <option value="NoCumple">No Cumple</option>
                </select>
            </div>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="table" id="cumplimientosTable">
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th style="width: 120px;">FECHA</th>
                            <th>REQUISITO</th>
                            <th style="width: 120px;">CLÁUSULA</th>
                            <th style="width: 180px;">NORMA ISO</th>
                            <th style="width: 130px; text-align: center;">ESTADO</th>
                            <th style="width: 150px;">RESPONSABLE</th>
                            <th style="width: 80px; text-align: center;">EVID.</th>
                            <th style="width: 150px; text-align: center;">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int contador = 1;
                        }
                        @foreach (var item in Model.Cumplimientos)
                        {
                            <tr data-estado="@item.Estado">
                                <td>
                                    <span class="badge badge-secondary" style="font-size: 0.8125rem; padding: 0.375rem 0.625rem;">
                                        @contador
                                    </span>
                                </td>
                                <td style="color: var(--text-primary); font-size: 0.875rem;">
                                    @item.Fecha.ToString("dd/MM/yyyy")
                                </td>
                                <td style="color: var(--text-primary); max-width: 300px;">
                                    @if (!string.IsNullOrEmpty(item.DescripcionRequisito))
                                    {
                                        @(item.DescripcionRequisito.Length > 80 ? item.DescripcionRequisito.Substring(0, 80) + "..." : item.DescripcionRequisito)
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin descripción</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-primary" style="font-size: 0.8125rem; padding: 0.5rem 0.75rem;">
                                        @item.CodigoClausula
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-info" style="font-size: 0.75rem; padding: 0.5rem 0.75rem;">
                                        @item.NombreNormaIso
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    <span class="badge badge-@item.EstadoColor" style="font-size: 0.8125rem; padding: 0.5rem 0.75rem;">
                                        @item.EstadoTexto
                                    </span>
                                </td>
                                <td style="color: var(--text-primary); font-size: 0.875rem;">
                                    @item.NombreUsuarioResponsable
                                </td>
                                <td style="text-align: center;">
                                    @if (item.CantidadEvidencias > 0)
                                    {
                                        <span class="badge badge-success" style="font-size: 0.875rem; padding: 0.5rem 0.625rem;">
                                            @item.CantidadEvidencias
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.875rem;">0</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-action="Detalles" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Ver detalles"
                                           style="padding: 0.375rem 0.75rem;">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Editar" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-primary"
                                           title="Editar"
                                           style="padding: 0.375rem 0.75rem;">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            contador++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer" style="background-color: var(--body-bg); border-top: 1px solid var(--border-color); padding: 1rem 1.5rem;">
            <div class="d-flex justify-content-between align-items-center">
                <span style="color: var(--text-muted); font-size: 0.875rem;">
                    Mostrando <strong id="visibleCount">@Model.Cumplimientos.Count()</strong> de <strong>@Model.Cumplimientos.Count()</strong> cumplimientos
                </span>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center" style="padding: 3rem 1.5rem;">
            <div style="width: 80px; height: 80px; margin: 0 auto 1.5rem; background: rgba(115, 103, 240, 0.12); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-inbox" style="font-size: 2.5rem; color: var(--primary);"></i>
            </div>
            <h5 style="color: var(--text-primary); font-weight: 600; margin-bottom: 0.5rem;">
                No hay cumplimientos registrados
            </h5>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
                Comience evaluando los requisitos de sus normas ISO
            </p>
            <a asp-controller="Requisitos" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-clipboard-check"></i>
                Ver Requisitos
            </a>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Búsqueda y filtrado
        const searchInput = document.getElementById('searchInput');
        const filterEstado = document.getElementById('filterEstado');
        const tableRows = document.querySelectorAll('#cumplimientosTable tbody tr');
        const visibleCount = document.getElementById('visibleCount');

        function filterTable() {
            const searchValue = searchInput?.value.toLowerCase() || '';
            const estadoValue = filterEstado?.value || '';
            let visibleRows = 0;

            tableRows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const estado = row.getAttribute('data-estado');

                const matchSearch = text.includes(searchValue);
                const matchEstado = estadoValue === '' || estado === estadoValue;

                if (matchSearch && matchEstado) {
                    row.style.display = '';
                    visibleRows++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (visibleCount) {
                visibleCount.textContent = visibleRows;
            }
        }

        searchInput?.addEventListener('keyup', filterTable);
        filterEstado?.addEventListener('change', filterTable);

        // Auto-dismiss alerts
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}