@model RequisitoCrearViewModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Registro de Requisito";
}
<h1>Registro de Requisito</h1>

<form asp-action="Crear" >
    @* Campo oculto que envía el ID de la cláusula *@
    <input type="hidden" asp-for="ClausulaId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <!-- Mostrar el nombre de la Cláusula (solo lectura) -->
    <div class="mb-3">
        <label class="form-label">Cláusula</label>
        <input type="text" class="form-control" value="@Model.CodigoClausula" readonly />
    </div>
   @*  <div class="mb-3">
        <label asp-for="CodigoClausula" class="form-label"></label>
        <input asp-for="CodigoClausula" class="form-control" placeholder="Ej. 4.1.1" />
        <span asp-validation-for="CodigoClausula" class="text-danger"></span>
    </div> *@
    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <input asp-for="Descripcion" class="form-control" />
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-controller="Clausulas" asp-action="Listado" asp-route-id="@Model.ClausulaId" class="btn btn-secondary">Cancelar</a>

    
</form>