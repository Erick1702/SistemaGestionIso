@model RequisitoListadoViewModel

@{
    ViewData["Title"] = "Todos los Requisitos";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="mb-1" style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary);">
                    <i class="bi bi-clipboard-check text-primary"></i>
                    Todos los Requisitos
                </h4>
                <p class="mb-0" style="color: var(--text-muted); font-size: 0.875rem;">
                    Visualiza y gestiona todos los requisitos de todas las cláusulas
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Clausulas" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-list-check"></i>
                    Ver Cláusulas
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Alert Messages -->
@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i>
        <span>@Model.Mensaje</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Total Requisitos</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.Requisitos.Count()
                        </h3>
                    </div>
                    <div class="stats-icon primary">
                        <i class="bi bi-clipboard-check"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Cláusulas</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.Requisitos.Select(r => r.ClausulaId).Distinct().Count()
                        </h3>
                    </div>
                    <div class="stats-icon success">
                        <i class="bi bi-list-check"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Cumplimientos</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.Requisitos.Sum(r => r.CantidadCumplimientos)
                        </h3>
                    </div>
                    <div class="stats-icon info">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Hallazgos</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.Requisitos.Sum(r => r.CantidadHallazgos)
                        </h3>
                    </div>
                    <div class="stats-icon warning">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
@if (Model.Requisitos.Any())
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="card-title mb-0">Listado de Todos los Requisitos</h5>
            <div class="d-flex gap-2 flex-wrap">
                <div style="position: relative;">
                    <i class="bi bi-search" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);"></i>
                    <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Buscar..."
                           style="padding-left: 2.25rem; width: 200px; height: 36px;">
                </div>
                <select id="filterNorma" class="form-select form-select-sm" style="width: 180px; height: 36px;">
                    <option value="">Todas las normas</option>
                    @foreach (var norma in Model.Requisitos.Select(r => new { r.NormaIsoId, r.NombreNormaIso }).Distinct())
                    {
                        <option value="@norma.NormaIsoId">@norma.NombreNormaIso</option>
                    }
                </select>
            </div>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="table" id="requisitosTable">
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>DESCRIPCIÓN</th>
                            <th style="width: 150px;">CLÁUSULA</th>
                            <th style="width: 200px;">NORMA ISO</th>
                            <th style="width: 100px; text-align: center;">CUMPL.</th>
                            <th style="width: 100px; text-align: center;">HALLAZ.</th>
                            <th style="width: 180px; text-align: center;">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int contador = 1;
                        }
                        @foreach (var item in Model.Requisitos)
                        {
                            <tr data-norma-id="@item.NormaIsoId">
                                <td>
                                    <span class="badge badge-secondary" style="font-size: 0.8125rem; padding: 0.375rem 0.625rem;">
                                        @contador
                                    </span>
                                </td>
                                <td style="color: var(--text-primary); max-width: 400px;">
                                    @if (!string.IsNullOrEmpty(item.Descripcion))
                                    {
                                        @(item.Descripcion.Length > 120 ? item.Descripcion.Substring(0, 120) + "..." : item.Descripcion)
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin descripción</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-primary" style="font-size: 0.8125rem; padding: 0.5rem 0.75rem;">
                                        @item.CodigoClausula
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-info" style="font-size: 0.75rem; padding: 0.5rem 0.75rem;">
                                        @item.NombreNormaIso
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    @if (item.CantidadCumplimientos > 0)
                                    {
                                        <span class="badge badge-success" style="font-size: 0.875rem; padding: 0.5rem 0.625rem;">
                                            @item.CantidadCumplimientos
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.875rem;">0</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @if (item.CantidadHallazgos > 0)
                                    {
                                        <span class="badge badge-warning" style="font-size: 0.875rem; padding: 0.5rem 0.625rem;">
                                            @item.CantidadHallazgos
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.875rem;">0</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-action="Detalles" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Ver detalles"
                                           style="padding: 0.375rem 0.75rem;">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Editar" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-primary"
                                           title="Editar"
                                           style="padding: 0.375rem 0.75rem;">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            contador++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer" style="background-color: var(--body-bg); border-top: 1px solid var(--border-color); padding: 1rem 1.5rem;">
            <div class="d-flex justify-content-between align-items-center">
                <span style="color: var(--text-muted); font-size: 0.875rem;">
                    Mostrando <strong id="visibleCount">@Model.Requisitos.Count()</strong> de <strong>@Model.Requisitos.Count()</strong> requisitos
                </span>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center" style="padding: 3rem 1.5rem;">
            <div style="width: 80px; height: 80px; margin: 0 auto 1.5rem; background: rgba(115, 103, 240, 0.12); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-inbox" style="font-size: 2.5rem; color: var(--primary);"></i>
            </div>
            <h5 style="color: var(--text-primary); font-weight: 600; margin-bottom: 0.5rem;">
                No hay requisitos registrados
            </h5>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
                Comience agregando requisitos a las cláusulas de sus normas ISO
            </p>
            <a asp-controller="Clausulas" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-list-check"></i>
                Ver Cláusulas
            </a>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Búsqueda y filtrado
        const searchInput = document.getElementById('searchInput');
        const filterNorma = document.getElementById('filterNorma');
        const tableRows = document.querySelectorAll('#requisitosTable tbody tr');
        const visibleCount = document.getElementById('visibleCount');

        function filterTable() {
            const searchValue = searchInput?.value.toLowerCase() || '';
            const normaValue = filterNorma?.value || '';
            let visibleRows = 0;

            tableRows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const normaId = row.getAttribute('data-norma-id');

                const matchSearch = text.includes(searchValue);
                const matchNorma = normaValue === '' || normaId === normaValue;

                if (matchSearch && matchNorma) {
                    row.style.display = '';
                    visibleRows++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (visibleCount) {
                visibleCount.textContent = visibleRows;
            }
        }

        searchInput?.addEventListener('keyup', filterTable);
        filterNorma?.addEventListener('change', filterTable);

        // Auto-dismiss alerts
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}