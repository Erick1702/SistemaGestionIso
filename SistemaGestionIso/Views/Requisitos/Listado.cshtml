@using SistemaGestionIso.Models.Requisitos
@model RequisitoListadoViewModel

@{
    ViewData["Title"] = "Gestión de Requisitos";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb" style="background: transparent; padding: 0; margin-bottom: 1rem;">
                <li class="breadcrumb-item">
                    <a asp-controller="NormasIso" asp-action="Index" style="color: var(--primary); text-decoration: none;">
                        <i class="bi bi-journal-text"></i> Normas ISO
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Clausulas" asp-action="Listado" asp-route-id="@ViewBag.NormaIsoId" style="color: var(--primary); text-decoration: none;">
                        Cláusulas
                    </a>
                </li>
                <li class="breadcrumb-item active" style="color: var(--text-muted);">
                    Requisitos
                </li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="mb-1" style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary);">
                    Gestión de Requisitos
                </h4>
                <p class="mb-0" style="color: var(--text-muted); font-size: 0.875rem;">
                    Norma: <strong>@ViewBag.NombreNormaIso - @ViewBag.VersionNormaIso</strong> |
                    Cláusula: <strong>@ViewBag.CodigoClausula</strong>
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Clausulas" asp-action="Listado" asp-route-id="@ViewBag.NormaIsoId" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Volver a Cláusulas
                </a>
                <a asp-action="Crear" asp-route-clausulaId="@ViewBag.ClausulaId" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>
                    Nuevo Requisito
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Alert Messages -->
@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i>
        <span>@Model.Mensaje</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Clausula Info Card -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card" style="background: linear-gradient(135deg, rgba(115, 103, 240, 0.08) 0%, rgba(158, 149, 245, 0.08) 100%); border: 1px solid rgba(115, 103, 240, 0.2);">
            <div class="card-body">
                <div class="d-flex align-items-start gap-3">
                    <div style="width: 48px; height: 48px; background: var(--primary); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.25rem; flex-shrink: 0;">
                        <i class="bi bi-list-check"></i>
                    </div>
                    <div style="flex: 1;">
                        <h5 style="margin: 0 0 0.5rem 0; color: var(--text-primary); font-weight: 600;">
                            Cláusula @ViewBag.CodigoClausula
                        </h5>
                        <p style="margin: 0; color: var(--text-primary); line-height: 1.6;">
                            @ViewBag.DescripcionClausula
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Total Requisitos</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.Requisitos.Count()
                        </h3>
                    </div>
                    <div class="stats-icon primary">
                        <i class="bi bi-clipboard-check"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Cumplimientos</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.Requisitos.Sum(r => r.CantidadCumplimientos)
                        </h3>
                    </div>
                    <div class="stats-icon success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="stats-card">
                    <div class="stats-info">
                        <p style="margin: 0 0 0.25rem 0; color: var(--text-muted); font-size: 0.875rem;">Hallazgos</p>
                        <h3 style="margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
                            @Model.Requisitos.Sum(r => r.CantidadHallazgos)
                        </h3>
                    </div>
                    <div class="stats-icon warning">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
@if (Model.Requisitos.Any())
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Listado de Requisitos</h5>
            <div style="position: relative;">
                <i class="bi bi-search" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);"></i>
                <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Buscar..."
                       style="padding-left: 2.25rem; width: 200px; height: 36px;">
            </div>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="table" id="requisitosTable">
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>DESCRIPCIÓN</th>
                            <th style="width: 100px; text-align: center;">CUMPL.</th>
                            <th style="width: 100px; text-align: center;">HALLAZ.</th>
                            <th style="width: 200px; text-align: center;">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int contador = 1;
                        }
                        @foreach (var item in Model.Requisitos)
                        {
                            <tr>
                                <td>
                                    <span class="badge badge-secondary" style="font-size: 0.875rem; padding: 0.5rem 0.75rem;">
                                        @contador
                                    </span>
                                </td>
                                <td style="color: var(--text-primary);">
                                    @if (!string.IsNullOrEmpty(item.Descripcion))
                                    {
                                        <text>@item.Descripcion</text>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin descripción</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @if (item.CantidadCumplimientos > 0)
                                    {
                                        <span class="badge badge-success" style="font-size: 0.875rem; padding: 0.5rem 0.625rem;">
                                            @item.CantidadCumplimientos
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.875rem;">0</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @if (item.CantidadHallazgos > 0)
                                    {
                                        <span class="badge badge-warning" style="font-size: 0.875rem; padding: 0.5rem 0.625rem;">
                                            @item.CantidadHallazgos
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.875rem;">0</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-controller="Cumplimientos"
                                           asp-action="Listado"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-success"
                                           title="Gestión de Cumplimientos"
                                           style="padding: 0.375rem 0.75rem;">
                                            <i class="bi bi-check-circle"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                title="Ver Detalles"
                                                style="padding: 0.375rem 0.75rem;"
                                                onclick="viewDetails(@item.Id, '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Descripcion ?? "Sin descripción"))', @item.CantidadCumplimientos, @item.CantidadHallazgos)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <a asp-action="Editar" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-primary"
                                           title="Editar"
                                           style="padding: 0.375rem 0.75rem;">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                title="Eliminar"
                                                style="padding: 0.375rem 0.75rem;"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal-@item.Id">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Modal de Confirmación de Eliminación -->
                                    <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content" style="border-radius: 0.75rem; border: none;">
                                                <div class="modal-header" style="border-bottom: 1px solid var(--border-color); padding: 1.25rem 1.5rem;">
                                                    <h5 class="modal-title" style="color: var(--text-primary); font-weight: 600;">
                                                        <i class="bi bi-exclamation-triangle text-warning"></i>
                                                        Confirmar Eliminación
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body" style="padding: 1.5rem;">
                                                    <p style="margin: 0; color: var(--text-primary);">
                                                        ¿Está seguro de que desea eliminar este requisito?
                                                    </p>
                                                    <p style="margin: 0.5rem 0 0 0; color: var(--text-muted); font-size: 0.875rem;">
                                                        Esta acción no se puede deshacer.
                                                    </p>
                                                </div>
                                                <div class="modal-footer" style="border-top: 1px solid var(--border-color); padding: 1rem 1.5rem;">
                                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                                        Cancelar
                                                    </button>
                                                    <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger">
                                                            <i class="bi bi-trash"></i>
                                                            Eliminar
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            contador++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer" style="background-color: var(--body-bg); border-top: 1px solid var(--border-color); padding: 1rem 1.5rem;">
            <div class="d-flex justify-content-between align-items-center">
                <span style="color: var(--text-muted); font-size: 0.875rem;">
                    Mostrando <strong>@Model.Requisitos.Count()</strong> requisitos
                </span>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center" style="padding: 3rem 1.5rem;">
            <div style="width: 80px; height: 80px; margin: 0 auto 1.5rem; background: rgba(115, 103, 240, 0.12); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-inbox" style="font-size: 2.5rem; color: var(--primary);"></i>
            </div>
            <h5 style="color: var(--text-primary); font-weight: 600; margin-bottom: 0.5rem;">
                No hay requisitos registrados
            </h5>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem; max-width: 400px; margin-left: auto; margin-right: auto;">
                Comience agregando un nuevo requisito para la cláusula <strong>@ViewBag.CodigoClausula</strong>
            </p>
            <a asp-action="Crear" asp-route-clausulaId="@ViewBag.ClausulaId" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Crear Primer Requisito
            </a>
        </div>
    </div>
}

<!-- Modal de Detalles -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 0.75rem; border: none;">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color); padding: 1.25rem 1.5rem; background: linear-gradient(135deg, rgba(115, 103, 240, 0.08) 0%, rgba(158, 149, 245, 0.08) 100%);">
                <h5 class="modal-title" style="color: var(--text-primary); font-weight: 600;">
                    <i class="bi bi-info-circle text-primary"></i>
                    Detalles del Requisito
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 1.5rem;">
                <div class="row">
                    <div class="col-12 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Descripción</label>
                        <p id="detailDescripcion" style="font-size: 1rem; color: var(--text-primary); margin: 0.25rem 0 0 0; line-height: 1.6;"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Cumplimientos</label>
                        <p id="detailCumplimientos" style="font-size: 1.125rem; font-weight: 600; color: var(--success); margin: 0.25rem 0 0 0;"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Hallazgos</label>
                        <p id="detailHallazgos" style="font-size: 1.125rem; font-weight: 600; color: var(--warning); margin: 0.25rem 0 0 0;"></p>
                    </div>
                    <div class="col-12">
                        <label style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Cláusula</label>
                        <p style="font-size: 1rem; color: var(--text-primary); margin: 0.25rem 0 0 0;">
                            <strong>@ViewBag.CodigoClausula</strong> - @ViewBag.DescripcionClausula
                        </p>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--border-color); padding: 1rem 1.5rem;">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Búsqueda en tiempo real
        document.getElementById('searchInput')?.addEventListener('keyup', function() {
            const searchValue = this.value.toLowerCase();
            const tableRows = document.querySelectorAll('#requisitosTable tbody tr');

            tableRows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchValue) ? '' : 'none';
            });
        });

        // Función para mostrar detalles
        function viewDetails(id, descripcion, cumplimientos, hallazgos) {
            document.getElementById('detailDescripcion').textContent = descripcion;
            document.getElementById('detailCumplimientos').textContent = cumplimientos;
            document.getElementById('detailHallazgos').textContent = hallazgos;

            const modal = new bootstrap.Modal(document.getElementById('detailsModal'));
            modal.show();
        }

        // Auto-dismiss alerts
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}